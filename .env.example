# AidRelay: copy to .env and fill in. Sandbox only; live PayPal is out of scope.
# Keep this file in sync with lib/env.ts.

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=                 # public value; the /donate page hands it to the browser at request time
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

ANTHROPIC_API_KEY=

FIREBASE_PROJECT_ID=
# Leave empty to use Application Default Credentials: `gcloud auth application-default login` locally,
# or the service account attached to the Cloud Run service. Set a path only if your org allows JSON keys.
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=

APP_URL=http://localhost:3000
ADMIN_PASSWORD=
AGENT_INTERNAL_SECRET=

# Policy knobs read by lib/agent/guardrails.ts (dollars; converted to cents internally)
AUTO_APPROVE_LIMIT=250
AUTO_APPROVE_MIN_CONFIDENCE=0.85
AUTO_APPROVE_DOUBLE_CHECK=true   # P-9.9: second independent evaluation before an unattended payout (costs one extra Sonnet call per auto-pay)
FUND_ID=default

# Demo setting. true: anyone can look at /ops (contact details hidden); approving, rejecting and paying still need
# ADMIN_PASSWORD. false: the whole operator console is behind the login, as a real fund would run it.
OPS_PUBLIC_VIEW=true

# Optional. Without them AG Grid Enterprise / AG Studio render with a watermark.
AG_GRID_LICENSE_KEY=
AG_STUDIO_LICENSE_KEY=
